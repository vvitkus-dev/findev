{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "findev": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "define": {
              "BUILD_SHA": "\"dev\""
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "findev:build:production"
            },
            "development": {
              "buildTarget": "findev:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "configurations": {
            "ci": {
              "coverage": true,
              "runnerConfig": "vitest-base.config.mts",
              "coverageInclude": ["src/app/**/*.ts"],
              "coverageExclude": [
                "src/app/**/*.spec.ts",
                "src/app/**/*.model.ts",
                "src/app/app.config.ts",
                "src/app/**/producer.worker.ts"
              ],
              "coverageReporters": ["text-summary", "lcov", "json-summary", "html"],
              "coverageThresholds": {
                "statements": 65,
                "branches": 65,
                "functions": 65,
                "lines": 65
              }
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html", "wasm-tests/**/*.ts"]
          }
        }
      }
    }
  }
}
