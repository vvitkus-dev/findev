{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-lint-file.mjs\"",
            "timeout": 60,
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ]
  }
}
