{
  "name": "findev",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint:types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "lint": "ng lint --max-warnings 0",
    "lint:probes": "node scripts/lint-probes.mjs",
    "test:lint-rules": "node --test 'eslint-rules/*.test.mjs'",
    "dup": "jscpd -c .jscpd.json",
    "quality:probes": "node scripts/quality-probes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip --no-progress",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test:unit": "ng test --watch=false",
    "static": "npm run format:check && npm run lint && npm run lint:types && npm run dup && npm run deadcode && npm run audit",
    "quality:self-test": "npm run lint:probes && npm run test:lint-rules && npm run quality:probes && npm run hook:probes",
    "verify:fast": "npm run static && npm run test:rust && npm run test:unit",
    "verify": "npm run static && npm run quality:self-test && npm run test:rust && npm run test:rust:mutants && npm run wasm:build && npm run wasm:verify && npm run test:unit && npm run build",
    "prepare": "husky",
    "hook:probes": "node scripts/hook-probes.mjs",
    "rust:fmt": "node scripts/cargo.mjs fmt",
    "rust:lint": "node scripts/cargo.mjs fmt --check && node scripts/cargo.mjs clippy --all-targets -- -D warnings && node scripts/cargo.mjs clippy --lib --release --target wasm32-unknown-unknown -- -D warnings",
    "test:rust": "npm run rust:lint && node scripts/cargo.mjs test",
    "test:rust:mutants": "node scripts/rust-mutants.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:verify": "node scripts/verify-wasm.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.7.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "husky": "9.1.7",
    "jscpd": "5.4.3",
    "jsdom": "^30.0.0",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  }
}
