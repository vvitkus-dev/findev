{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Dead-code gate (docs/QUALITY_GATES_PLAN.md Q0.8): unused files, exports, dependencies.
  // Web Workers are entry points: they are loaded via `new Worker(new URL(...))`, never imported.
  "entry": ["scripts/*.mjs", "eslint-rules/*.{js,mjs}", "src/**/*.worker.ts"],
  "project": [
    "src/**/*.ts",
    "wasm-tests/**/*.ts",
    "scripts/**/*.mjs",
    "eslint-rules/**/*.{js,mjs}",
    "e2e/**/*.ts",
  ],
  // Two Vitest setups: Angular unit tests (`ng test`, no config file) and the Node Wasm suite.
  // Declared explicitly: once wasm-tests/vitest.config.mts exists, knip would otherwise only see its tests.
  "vitest": {
    "config": ["wasm-tests/vitest.config.mts"],
    "entry": ["src/**/*.spec.ts", "wasm-tests/**/*.test.ts"],
  },
}
